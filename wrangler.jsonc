{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "songjiayun",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker.js",
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  }
}
